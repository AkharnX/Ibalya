# --- Base de données ---
# Générez-en un : openssl rand -base64 32 | tr -d "/+=" | cut -c1-32
DB_PASSWORD=A_REMPLACER_avant_toute_mise_en_ligne
DATABASE_URL=postgres://ibalya:A_REMPLACER_avant_toute_mise_en_ligne@127.0.0.1:5435/ibalya?sslmode=disable

# --- Backend ---
API_ADDR=127.0.0.1:9999
ADMIN_TOKEN=change-me-long-random-token
LLM_SERVICE_URL=http://127.0.0.1:8092
PUBLIC_BASE_URL=http://localhost:9999

# --- Service LLM (Python) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
LLM_ADDR=127.0.0.1:8092

# --- Gmail OAuth (Google Cloud Console > Credentials > OAuth Client ID, type Web) ---
# Redirect URI à déclarer : {PUBLIC_BASE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cycles ---
INGEST_INTERVAL_MINUTES=15
DETECT_INTERVAL_MINUTES=30
DIGEST_HOUR=7
