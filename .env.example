# --- Base de données ---
# Générez-en un : openssl rand -base64 32 | tr -d "/+=" | cut -c1-32
DB_PASSWORD=A_REMPLACER_avant_toute_mise_en_ligne
DATABASE_URL=postgres://ibalya:A_REMPLACER_avant_toute_mise_en_ligne@127.0.0.1:5435/ibalya?sslmode=disable

# --- Backend ---
API_ADDR=127.0.0.1:9999
ADMIN_TOKEN=change-me-long-random-token
LLM_SERVICE_URL=http://127.0.0.1:8092
PUBLIC_BASE_URL=http://localhost:9999

# --- Service LLM (Python) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
LLM_ADDR=127.0.0.1:8092

# --- Gmail OAuth (Google Cloud Console > Credentials > OAuth Client ID, type Web) ---
# Redirect URI à déclarer : {PUBLIC_BASE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cycles ---
INGEST_INTERVAL_MINUTES=15
DETECT_INTERVAL_MINUTES=30
DIGEST_HOUR=7

# --- Canal IMAP (alternative à Gmail : Yahoo, OVH, Gandi, Orange, Free, auto-hébergé) ---
# CHANNEL=imap
IMAP_HOST=imap.exemple.fr
IMAP_PORT=993
IMAP_USER=dirigeant@exemple.fr
IMAP_PASSWORD=mot-de-passe-d-application
IMAP_FOLDER=INBOX
# Déduit de IMAP_HOST si vide (imap. → smtp.)
SMTP_HOST=
SMTP_PORT=587
# Développement uniquement : le serveur refuse de démarrer avec cette option
# sur une adresse publique en https.
# IMAP_TLS_SKIP_VERIFY=1

# Chiffre les secrets stockés en base (mot de passe IMAP). 32 caractères minimum.
# Générez-la : openssl rand -base64 48 | tr -d "/+=" | cut -c1-48
ENCRYPTION_KEY=A_REMPLACER_avant_toute_mise_en_ligne

# --- Canal Outlook (Microsoft Graph) ---
# Enregistrement Azure requis : voir docs/RACCORDEMENT_OUTLOOK.md
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# « common » accepte comptes professionnels et personnels
MICROSOFT_TENANT=common
